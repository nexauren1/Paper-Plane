{
  "name": "paper-plane-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply paper_plane_db --local",
    "db:remote": "wrangler d1 migrations apply paper_plane_db --remote",
    "db:test": "python3 scripts/validate_migrations.py",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0",
    "@cloudflare/vitest-plugin": "^1.2.4",
    "vitest": "^4.1.0"
  }
}
